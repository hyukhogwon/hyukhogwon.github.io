---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = '권혁호 — Frontend Engineer',
	description = '복잡한 업무 규칙을 명시적인 모델과 검증 가능한 구조로 바꾸는 프론트엔드 엔지니어 권혁호입니다.',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f1e8" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ko_KR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">본문으로 건너뛰기</a>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="권혁호 포트폴리오 홈">HYUKHO</a>
			<nav aria-label="주요 메뉴">
				<a href="/#projects">프로젝트</a>
				<a href="/#about">소개</a>
				<a href="mailto:hyukho.career@gmail.com">연락</a>
			</nav>
		</header>
		<main id="main"><slot /></main>
		<footer class="site-footer">
			<p>복잡한 문제를 설명 가능한 구조로 만듭니다.</p>
			<div>
				<a href="mailto:hyukho.career@gmail.com">Email</a>
				<a href="https://github.com/hyukhogwon" rel="me">GitHub</a>
			</div>
		</footer>
	</body>
</html>
